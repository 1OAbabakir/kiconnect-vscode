{
  "name": "kiconnect-vscode",
  "displayName": "KI:connect VS Code Extension",
  "description": "Unofficial VS Code extension that adds KI:connect models to the built‑in chat.",
  "version": "0.0.1",
  "author": "Omed Ababakir",
  "publisher": "omed-ababakir",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": ["AI"],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kiconnect.setApiKey",
        "title": "KI:connect: Set API Key"
      },
      {
        "command": "kiconnect.clearApiKey",
        "title": "KI:connect: Clear API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
}}