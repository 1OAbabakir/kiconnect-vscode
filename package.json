{
  "name": "kiconnect-vscode",
  "displayName": "KI:connect",
  "description": "KI:connect im integrierten VS-Code-Chat – mit interaktiver Einrichtung, Modellwahl, Streaming und Werkzeugunterstützung.",
  "version": "1.0.0",
  "publisher": "omed-ababakir",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:kiconnect",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kiconnect.setApiKey",
        "title": "KI:connect: API-Schlüssel hinterlegen"
      },
      {
        "command": "kiconnect.clearApiKey",
        "title": "KI:connect: API-Schlüssel entfernen"
      },
      {
        "command": "kiconnect.openChat",
        "title": "KI:connect: Chat öffnen"
      },
      {
        "command": "kiconnect.startSetup",
        "title": "KI:connect: Einrichtung starten"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "kiconnect",
        "displayName": "KI:connect",
        "managementCommand": "kiconnect.setApiKey"
      }
    ],
    "configuration": {
      "title": "KI:connect",
      "properties": {
        "kiconnect.fallbackContextWindow": {
          "type": "integer",
          "default": 131072,
          "minimum": 1024,
          "maximum": 2097152,
          "description": "Kontextbudget inklusive Antwort, falls die API keine Kontextgröße meldet. Eine Vorgabe der Erweiterung, keine bestätigte Servergrenze."
        },
        "kiconnect.fallbackMaxOutputTokens": {
          "type": "integer",
          "default": 8192,
          "minimum": 1,
          "maximum": 131072,
          "description": "Reserviertes Antwortbudget, falls die API keine Ausgabegrenze meldet."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node test/chat.test.cjs",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.4.0"
  },
  "author": "Omed Ababakir",
  "repository": {
    "type": "git",
    "url": "https://github.com/1OAbabakir/kiconnect-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/1OAbabakir/kiconnect-vscode/issues"
  },
  "homepage": "https://github.com/1OAbabakir/kiconnect-vscode#readme",
  "icon": "assets/icon.png",
  "license": "MIT",
  "keywords": [
    "KI:connect",
    "KI",
    "Chat",
    "NRW",
    "Werkzeuge"
  ],
  "galleryBanner": {
    "color": "#112D42",
    "theme": "dark"
  }
}
